{
  "name": "el-utilero",
  "version": "0.1.0",
  "private": true,
  "description": "EL UTILERO — videos cortos de fútbol. Biblia de marca en BRAND.md",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-episode.ts",
    "timeline": "tsx scripts/timeline.ts",
    "voice": "tsx scripts/generate-voice.ts",
    "sfx": "tsx scripts/generate-sfx.ts",
    "sfx:placeholder": "bash scripts/synth-placeholder-sfx.sh",
    "stills": "tsx scripts/stills.ts",
    "render": "tsx scripts/render.ts",
    "audio:norm": "bash scripts/normalize-audio.sh"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/layout-utils": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
